<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KinKeeper">

        <activity
            android:name=".HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MedicationsActivity" android:exported="false" />
        <activity android:name=".MedicationFormActivity" android:exported="false" />
        <activity android:name=".AppointmentsActivity" android:exported="false" />
        <activity android:name=".AppointmentFormActivity" android:exported="false" />
        <activity android:name=".CareLogActivity" android:exported="false" />
        <activity android:name=".ProfileActivity" android:exported="false" />
        <activity android:name=".EmergencyActivity" android:exported="false" />

    </application>

</manifest>
